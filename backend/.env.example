# --- Operational defaults (overridable from dashboard at runtime) ---
DEFAULT_LOCATION=Israel
DEFAULT_EMAIL=jackamichai@gmail.com
SCAN_CRON=0 10 * * *
RELEVANCE_THRESHOLD=75

# --- LLM provider (pick anthropic OR openai) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Notifications (pick Resend OR SMTP) ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Storage (swap to Postgres/Neon/Supabase by changing the URL) ---
DATABASE_URL=sqlite+aiosqlite:///./data/jobs.db

# --- Scraper tuning ---
SCRAPER_CONCURRENCY=3
SCRAPER_MAX_RETRIES=3
SCRAPER_HEADLESS=true
